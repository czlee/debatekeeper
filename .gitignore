# Sound files
# The real desk_bell*.mp3 files are licensed and must not be committed (see
# README). Locally generated placeholder desk_bell*.wav files (any decodable
# audio works, since R.raw.desk_bell ignores the extension) are also ignored.
app/src/main/res/raw/desk_bell*.mp3
app/src/main/res/raw/desk_bell*.wav

# Standard Android .gitignore
# https://github.com/github/gitignore/blob/master/Android.gitignore
# Built application files
*.aab
*.apk
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/

# Gradle files
.gradle/
/.idea/
local.properties
.DS_Store
build
*.iml

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/
